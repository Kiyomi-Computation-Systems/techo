(import (rnrs) (chez-sqlite3))
(define (show l v) (display l) (display ": ") (write v) (newline))
(show "version" (sqlite-version))
(show "path" (sqlite-library-path))
(show "options" (sqlite-compile-options))
(call-with-database ":memory:"
  (lambda (db)
    (execute! db "create virtual table t using fts5(title, body)")
    (execute! db "insert into t values ('a','hello world')")
    (show "fts5" (query db "select title from t where t match 'hello'"))
    (show "json" (query db "select json_extract('{\"a\":[1,2,{\"b\":7}]}', '$.a[2].b')"))
    (show "page_size" (query db "pragma page_size"))
    (show "sync-default" (query db "pragma synchronous"))
    (show "jm" (query db "pragma journal_mode=wal"))
    (show "cache" (query db "pragma cache_size"))))
