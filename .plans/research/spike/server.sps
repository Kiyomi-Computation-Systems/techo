;; server.sps DB-PATH  -- port from CHEZ_HTTP_PORT. GET /health (no db), GET /search?q=WORD (FTS on the loop thread).
(import (rnrs) (circuit) (circuit http-server) (circuit router)
        (chez-sqlite3) (spike))
(define path (cadr (command-line)))
(define db (open-spike-db path 'full 2000))
(define sql "select n.id, n.title from nodes_fts f join nodes n on n.rowid = f.rowid where nodes_fts match ? order by rank limit 50")
(define (text status s) (make-res status '(("content-type" . "text/plain")) s))
(define (health req) (text 200 "ok\n"))
(define (split-amp s)
  (let loop ((i 0) (start 0) (acc '()))
    (cond ((= i (string-length s)) (reverse (cons (substring s start i) acc)))
          ((char=? (string-ref s i) #\&) (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
          (else (loop (+ i 1) start acc)))))
(define (q-param req)
  (let loop ((parts (split-amp (or (req-query req) ""))))
    (cond ((null? parts) "")
          ((and (> (string-length (car parts)) 2) (string=? (substring (car parts) 0 2) "q="))
           (substring (car parts) 2 (string-length (car parts))))
          (else (loop (cdr parts))))))
(define (search req) (text 200 (number->string (length (query db sql (q-param req))))))
(run-server (make-router (list (route "/health" (GET health)) (route "/search" (GET search)))))
