;; diag.sps -- where do the ~7.5 ms outliers in read/list come from? Records Chez GC pauses.
(import (rnrs) (only (chezscheme) collect collect-request-handler) (chez-sqlite3) (spike))
(define db (open-spike-db "build/spike/medium.bench.db" 'full 2000))
(define pauses '())
(collect-request-handler (lambda () (let ((t0 (now-ns))) (collect) (set! pauses (cons (ms (- (now-ns) t0)) pauses)))))
(define rng (make-rng 5))
(define sql "select id, owner, kind, title, body, content_type, props, parent, revision, created, updated from nodes where id=?")
(define slow '())
(do ((i 0 (+ i 1))) ((= i 3000))
  (let* ((id (node-id (rng-below! rng 20000))) (t0 (now-ns)) (r (query-row db sql id)) (d (ms (- (now-ns) t0))))
    (when (> d 1.0) (set! slow (cons (cons i d) slow)))))
(out-line (string-append "reads over 1 ms: " (number->string (length slow)) " " (call-with-string-output-port (lambda (p) (write (reverse slow) p)))))
(out-line (string-append "GC pauses over 0.5 ms (ms): " (call-with-string-output-port (lambda (p) (write (reverse (filter (lambda (x) (> x 0.5)) pauses)) p)))))
(out-line (string-append "total GCs: " (number->string (length pauses))))
