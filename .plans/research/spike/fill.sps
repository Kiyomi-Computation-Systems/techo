;; fill.sps SIZE  -- fills build/spike/SIZE.db (deleting any old one).
(import (rnrs) (only (chezscheme) file-length open-file-input-port)
        (chez-sqlite3) (spike))
(define size (cadr (command-line)))
(define n (cond ((string=? size "small") 1000) ((string=? size "medium") 20000) ((string=? size "large") 200000) (else (error 'fill "unknown size" size))))
(define revs (cond ((string=? size "small") 5) ((string=? size "medium") 10) (else 2)))
(define path (string-append "build/spike/" size ".db"))
(for-each (lambda (suffix) (let ((f (string-append path suffix))) (when (file-exists? f) (delete-file f))))
          '("" "-wal" "-shm"))
(define (fsize f) (if (file-exists? f) (let ((p (open-file-input-port f))) (let ((l (file-length p))) (close-port p) l)) 0))
(define db (open-spike-db path 'normal 2000))
(create-schema! db)
(define nproj (div n 200))
(define kinds '#("Note" "Task" "Contact" "Journal"))
(define (props-for kind i)
  (cond ((string=? kind "Task") (string-append "{\"status\":\"TODO\",\"deadline\":\"2026-12-" (number->string (+ 10 (mod i 18))) "\"}"))
        ((string=? kind "Contact") (string-append "{\"names\":[\"Person " (number->string i) "\"],\"emails\":[\"p" (number->string i) "@example.org\"]}"))
        (else "{}")))
(define t0 (now-ns))
(define seq 0)
(define (do-node! i)
  (let* ((id (node-id i))
         (kind (if (< i nproj) "Project" (vector-ref kinds (mod i 4))))
         (parent (if (< i nproj) sql-null (node-id (mod i nproj))))
         (props (props-for kind i))
         (ts (+ 1700000000000 (* i 1000))))
    (let ((seed (+ (* i 16) revs)))
      (execute! db "insert into nodes values (?,?,?,?,?,?,?,?,?,?,?)"
                id 1 kind (node-title seed) (make-body seed) "text/markdown" props parent revs ts (+ ts revs)))
    (do ((r 1 (+ r 1))) ((> r revs))
      (let* ((seed (+ (* i 16) r)) (title (node-title seed)) (body (make-body seed)))
        (execute! db "insert into revisions values (?,?,?,?,?,?)" id r title body props (+ ts r))
        (set! seq (+ seq 1))
        (execute! db "insert into changes values (1,?,?,?,?,?)" seq id r (if (= r 1) "create" "update") (+ ts r))))))
(let loop ((i 0))
  (when (< i n)
    (let ((end (min n (+ i 500))))
      (with-transaction db (lambda () (do ((k i (+ k 1))) ((= k end)) (do-node! k))))
      (loop end))))
(define t1 (now-ns))
(out-line (string-append "fill " size ": nodes=" (number->string n) " revisions/node=" (number->string revs)
                         " fill_seconds=" (number->string (/ (round (/ (- t1 t0) 1e8)) 10.0))))
(out-line (string-append "  size before checkpoint: db=" (number->string (fsize path)) " wal=" (number->string (fsize (string-append path "-wal")))))
(query db "pragma wal_checkpoint(TRUNCATE)")
(out-line (string-append "  size after  checkpoint: db=" (number->string (fsize path)) " wal=" (number->string (fsize (string-append path "-wal")))))
(define (count t) (vector-ref (query-row db (string-append "select count(*) from " t)) 0))
(out-line (string-append "  rows: nodes=" (number->string (count "nodes")) " revisions=" (number->string (count "revisions")) " changes=" (number->string (count "changes"))))
(out-line (string-append "  pragma page_size=" (number->string (vector-ref (query-row db "pragma page_size") 0))
                         " page_count=" (number->string (vector-ref (query-row db "pragma page_count") 0))))
(close-database! db)
