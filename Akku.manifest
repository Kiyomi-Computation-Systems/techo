#!r6rs ; -*- scheme -*-
(import (akku format manifest))

;; Techo's own dependencies from the Akku index, and the index dependencies
;; of the libraries Techo takes as git submodules under vendor/ (ADR-0011):
;; Akku cannot read a submodule's manifest, so each is repeated here, and
;; `make check-pins` fails when this file misses one that a submodule's own
;; Akku.manifest names.
;;
;; threading: Techo's own. circuit's: chez-http-server, under its adapter;
;; chez-websocket; hashing; and jsonparse. The server's: chez-libuv,
;; chez-httparse, chez-uri and byte-machine. unique-id's: chez-srfi, for the
;; SRFI-19 clock in (unique-id system), which Techo does not import.
;; chez-sqlite3, chez-curl and chez-sodium need nothing from the index.
;;
;; chez-http-server stays at ^0.11.0, as circuit's manifest has it, though
;; the path takes 0.12.0 from the submodule vendor/chez-http-server: the
;; index has no 0.12.0 yet, and chez-websocket 0.6.0 admits only 0.11
;; (ADR-0011, amended 2026-11-23, which says what ends this). Akku.lock is `akku lock`'s output
;; for this file (`make lock`; `make check-akku-lock` holds it). `make
;; fetch` fetches each tree as the lock pins it.
;;
;; Development only: chez-srfi gives the suites SRFI-64, at a later floor
;; than unique-id asks for.
(akku-package ("techo" "0.0.0")
  (synopsis "A personal knowledge server in Chez Scheme")
  (authors "Kiyomi Computation Systems LLC")
  (homepage "https://github.com/Kiyomi-Computation-Systems/techo")
  (license "BSD-3-Clause")
  (depends ("threading" "^0.1.1")
           ("chez-http-server" "^0.11.0")
           ("chez-websocket" "^0.6.0")
           ("hashing" "^1.4.0")
           ("jsonparse" "^0.2.0")
           ("chez-libuv" "^0.11.0")
           ("chez-httparse" "^0.6.0")
           ("chez-uri" "^0.9.0")
           ("byte-machine" "^0.9.0")
           ("chez-srfi" "^0.0.0-akku.181.7879b52"))
  (depends/dev ("chez-srfi" "^0.0.0-akku.291.5219353")))
